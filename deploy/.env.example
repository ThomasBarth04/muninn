# Copy to deploy/.env (never committed) and fill in. ADR 0008: configuration is
# environment variables; leaving is copying this file to another box.

# Passwords go into connection URLs: keep them URL-safe (openssl rand -hex 32).

# --- Box -------------------------------------------------------------------
# Caddy gets the TLS certificate for this
DOMAIN=app.muninn.io
# superuser; only wal-g and humans use it
POSTGRES_PASSWORD=
# muninn_owner: owns tables, runs migrations
MUNINN_OWNER_PASSWORD=
# muninn_app: what the app connects as (RLS applies)
MUNINN_APP_PASSWORD=

# --- Backups: wal-g to Hetzner Object Storage (EU) ---------------------------
WALG_S3_PREFIX=s3://muninn-backups/prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_REGION=fsn1
AWS_S3_FORCE_PATH_STYLE=true

# --- App -------------------------------------------------------------------
# image tag to run: latest (main) or a git sha to roll back to
MUNINN_TAG=latest
RUST_LOG=muninn=info,tower_http=info
# links in emails, Stripe return URLs
APP_URL=https://app.muninn.io
# workspaces receive at <slug>@INBOUND_DOMAIN
INBOUND_DOMAIN=in.muninn.io
# From of setup, reset and invite links
MAIL_FROM=Muninn <login@muninn.io>

# --- Postmark (ADR 0005, 0009) -----------------------------------------------
# unset: emails are logged, not sent
POSTMARK_SERVER_TOKEN=
# domains API, for custom sending domains
POSTMARK_ACCOUNT_TOKEN=
# setup, reset and invite links
POSTMARK_SYSTEM_STREAM=outbound
# replies from paying workspaces
POSTMARK_CUSTOMER_STREAM=customers
# replies from trial workspaces, isolated
POSTMARK_TRIAL_STREAM=trials
# basic auth in the inbound webhook URL
POSTMARK_INBOUND_USER=postmark
# required; long and random
POSTMARK_INBOUND_PASSWORD=

# --- Jev (ADR 0002) ------------------------------------------------------------
# unset: suggestions and categories fail visibly
JEV_API_KEY=

# --- Stripe (spec 001) -----------------------------------------------------------
STRIPE_SECRET_KEY=
# whsec_… of the /hooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=
# the per-seat monthly price
STRIPE_PRICE_ID=

# --- HubSpot (spec 007) ----------------------------------------------------------
# Muninn's HubSpot app; unset: no HubSpot sync. Its redirect URL is
# $APP_URL/api/integrations/hubspot/callback, its webhook $APP_URL/hooks/hubspot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
